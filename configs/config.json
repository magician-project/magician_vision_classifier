{


    "hparams":{


      "tile_size": 64,


      "batch_size": 64,


      "training_epochs": 15,


      "dropout_rate": 0.20,


      "seed": 42,


      "gradient_clip_value": 1.0,


      "AoLP": false, 


      "DoLP": false,


      "unpolarized": false


    },


    "early_stopping": {


        "monitor":"loss",


        "mode": "min",


        "patience": 16,


        "min_delta": 0.0005,


        "verbose": 1,


        "restore_best_weights": true


    },


    "optimizer": {


        "type": "AdamW",


        "learning_rate": 5e-4


    },


    "dataloader": {


        "seed": 42,


        "validation_split": 0.1,


        "shuffle": false,


        "label_mode": "categorical",


        "num_workers": 12


        


    },


    "wandb": {


        "project": "Classifier",


        "name": "Monochrome+4POLS",


        "use_wandb": true


    },




    "directory": "keras_dataset/",


    "class_weight": false,


    "loss": "focal",


    "accelerator": "auto",


    "model": "resnet18",


    "devices": 1


  }
